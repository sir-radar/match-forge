{
  "contract": "QualityPolicyV1",
  "version": "statsbomb-quality-policy-v1",
  "rules": {
    "SB_SOURCE_CHECKSUM_MISMATCH": {"severity": "FATAL", "action": "ABORT_SCOPE"},
    "SB_DATASET_FILE_INTEGRITY": {"severity": "FATAL", "action": "ABORT_VALIDATION"},
    "SB_MALFORMED_EVENTS_PARQUET": {"severity": "QUARANTINE", "action": "QUARANTINE_FILE"},
    "SB_MALFORMED_EVENTS_JSON": {"severity": "QUARANTINE", "action": "QUARANTINE_RESOURCE"},
    "SB_DUPLICATE_MATCH": {"severity": "QUARANTINE", "action": "QUARANTINE_RESOURCE"},
    "SB_DUPLICATE_EVENT": {"severity": "QUARANTINE", "action": "QUARANTINE_RESOURCE"},
    "SB_MISSING_PLAYER": {"severity": "QUARANTINE", "action": "QUARANTINE_MATCH"},
    "SB_IMPOSSIBLE_EVENT_TIMESTAMP": {"severity": "WARNING", "action": "USE_EVENT_INDEX_AND_EXCLUDE_TEMPORAL_FEATURES"},
    "SB_INVALID_EVENT_COORDINATES": {"severity": "QUARANTINE", "action": "QUARANTINE_RESOURCE"},
    "SB_SCORE_INCONSISTENCY": {"severity": "QUARANTINE", "action": "QUARANTINE_MATCH"},
    "SB_LINEUP_INCONSISTENCY": {"severity": "QUARANTINE", "action": "QUARANTINE_MATCH"},
    "SB_NONMONOTONIC_POSITION_STINT": {"severity": "WARNING", "action": "PRESERVE_AND_REVIEW"},
    "SB_UNKNOWN_EVENT_TYPE": {"severity": "WARNING", "action": "PRESERVE_WITH_NULL_CANONICAL_MAPPING"},
    "SB_EVENT_LOCATION_OUT_OF_BOUNDS": {"severity": "WARNING", "action": "EXCLUDE_FROM_DERIVED_SPATIAL_FEATURES"},
    "SB_DUPLICATE_EVENT_INDEX": {"severity": "QUARANTINE", "action": "QUARANTINE_RESOURCE"},
    "SB_UNKNOWN_ADDITIVE_FIELD": {"severity": "INFO", "action": "PRESERVE_AND_CONTINUE"},
    "SB_360_UNAVAILABLE": {"severity": "INFO", "action": "MARK_UNAVAILABLE"}
  }
}
