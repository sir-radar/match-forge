{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ModelArtifactManifestV1",
  "type": "object",
  "required": [
    "contract",
    "model_artifact_id",
    "model_family",
    "fit_spec_sha256",
    "schema_version",
    "algorithm_version",
    "serializer_version",
    "compatibility",
    "logical_model_state_sha256",
    "created_at",
    "files"
  ],
  "properties": {
    "contract": {"const": "ModelArtifactManifestV1"},
    "model_artifact_id": {"type": "string", "format": "uuid"},
    "model_family": {
      "enum": [
        "TEAM_ELO",
        "DIXON_COLES_GOALS",
        "CORNER_POISSON",
        "CORNER_NEGATIVE_BINOMIAL",
        "CALIBRATION_PLATT",
        "CALIBRATION_ISOTONIC",
        "CALIBRATION_MULTICLASS"
      ]
    },
    "fit_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "algorithm_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "serializer_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "compatibility": {
      "type": "object",
      "required": [
        "contract",
        "runtime",
        "runtime_version",
        "loader_version",
        "feature_contract_version"
      ],
      "properties": {
        "contract": {"const": "ArtifactCompatibilityV1"},
        "runtime": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "runtime_version": {"type": "string", "minLength": 1},
        "loader_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "feature_contract_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "additionalProperties": false
    },
    "logical_model_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "media_type", "size_bytes", "physical_sha256"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "physical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
