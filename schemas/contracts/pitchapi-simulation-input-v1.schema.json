{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitchapi-simulation-input-v1.schema.json",
  "title": "PitchApiSimulationInputV1",
  "description": "Input the Python PitchAPI evaluation adapters write for the Rust simulation-core validators. The file must be UTF-8 JSON with sorted keys and no insignificant whitespace, and its SHA-256 is passed on the command line. forecast_probability_sha256 is the SHA-256 of the atoms array re-serialized by simulation-core: sorted keys, no whitespace, and each probability as the shortest round-trip decimal, in plain notation from 1e-5 up to 1 and as <digits>e-<exponent> below 1e-5. Each analytic probability is the sum, in atom order, of the exact-score atoms that satisfy the event; unresolved_tail carries the tail atom.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "algorithm_version",
    "analytic_probabilities",
    "atoms",
    "canonical_match_id",
    "forecast_artifact_sha256",
    "forecast_id",
    "forecast_probability_sha256",
    "model_artifact_sha256",
    "policy_sha256",
    "protocol_id",
    "schema_version",
    "seed_schedule_id",
    "simulation_count"
  ],
  "properties": {
    "algorithm_version": {
      "enum": [
        "pitchapi-score-categorical-v1",
        "pitchapi-score-categorical-v2"
      ]
    },
    "analytic_probabilities": {
      "type": "array",
      "minItems": 62,
      "maxItems": 62,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "probability"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "atoms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/exact_score_atom"
          },
          {
            "$ref": "#/$defs/unresolved_tail_atom"
          }
        ]
      }
    },
    "canonical_match_id": {
      "type": "string",
      "minLength": 1
    },
    "forecast_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "forecast_id": {
      "type": "string",
      "minLength": 1
    },
    "forecast_probability_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "model_artifact_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "protocol_id": {
      "enum": [
        "PITCHAPI_DOMAIN_STRATIFIED_EVALUATION_V2",
        "PITCHAPI_DOMAIN_STRATIFIED_EVALUATION_V3",
        "PITCHAPI_DOMAIN_STRATIFIED_EVALUATION_V4"
      ]
    },
    "schema_version": {
      "const": "PitchApiSimulationInputV1"
    },
    "seed_schedule_id": {
      "enum": [
        "pitchapi-v2-splitmix64-sha256-v1",
        "pitchapi-v3-splitmix64-sha256-v1",
        "pitchapi-v4-splitmix64-sha256-v1"
      ]
    },
    "simulation_count": {
      "const": 112460
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exact_score_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "away_goals",
        "home_goals",
        "kind",
        "probability"
      ],
      "properties": {
        "away_goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "home_goals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "kind": {
          "const": "EXACT_SCORE"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "unresolved_tail_atom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "away_goals",
        "home_goals",
        "kind",
        "probability"
      ],
      "properties": {
        "away_goals": {
          "type": "null"
        },
        "home_goals": {
          "type": "null"
        },
        "kind": {
          "const": "UNRESOLVED_TAIL"
        },
        "probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1e-12
        }
      }
    }
  }
}
