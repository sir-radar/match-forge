{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentProtocolV1",
  "type": "object",
  "properties": {
    "contract": {
      "const": "ExperimentProtocolV1"
    },
    "protocol_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "hypothesis": {
      "type": "string",
      "pattern": "\\S"
    },
    "development_corpus": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "validation_corpus": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "evaluation_corpus": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "forbidden_target_manifest": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "feature_contract": {
      "type": "string",
      "pattern": "\\S"
    },
    "candidate_models": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fit_policy": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "calibration_policy": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evaluation_policy": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "promotion_policy": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "additionalProperties": false
    },
    "authorization_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "uri",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "contract",
    "protocol_id",
    "hypothesis",
    "development_corpus",
    "validation_corpus",
    "evaluation_corpus",
    "forbidden_target_manifest",
    "feature_contract",
    "candidate_models",
    "fit_policy",
    "calibration_policy",
    "evaluation_policy",
    "promotion_policy",
    "authorization_refs"
  ],
  "additionalProperties": false
}
