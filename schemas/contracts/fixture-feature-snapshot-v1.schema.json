  "$defs": {
    "context": {
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "not": {
          "enum": [
            "home_score",
            "away_score",
            "home_goals",
            "away_goals",
            "result",
            "score",
            "corners",
            "shots",
            "possession",
            "post_match_statistics"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
