{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Sprint1FixtureV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "name",
    "description",
    "provider",
    "repository",
    "source_git_sha",
    "license",
    "license_url",
    "attribution",
    "acquired_at",
    "resources",
    "expected"
  ],
  "properties": {
    "contract": {"const": "Sprint1FixtureV1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "provider": {"const": "statsbomb_open_data"},
    "repository": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "license": {"type": "string", "minLength": 1},
    "license_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "attribution": {"type": "string", "minLength": 1},
    "acquired_at": {"type": "string", "format": "date-time"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256", "media_type"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"const": "application/json"}
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "canonical", "dataset_rows", "finding_counts"],
      "allOf": [
        {
          "if": {
            "properties": {"outcome": {"const": "ingestion_error"}},
            "required": ["outcome"]
          },
          "then": {
            "required": ["error_message"],
            "properties": {
              "canonical": {"maxProperties": 0},
              "dataset_rows": {"type": "null"},
              "finding_counts": {"maxProperties": 0}
            }
          },
          "else": {
            "not": {"required": ["error_message"]},
            "properties": {"dataset_rows": {"type": "integer"}}
          }
        }
      ],
      "properties": {
        "outcome": {"enum": ["passed", "warnings", "quarantined", "ingestion_error"]},
        "canonical": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "dataset_rows": {"type": ["integer", "null"], "minimum": 0},
        "finding_counts": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z][A-Z0-9_]+$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "error_message": {"type": "string", "minLength": 1}
      }
    }
  }
}
