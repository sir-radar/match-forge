{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchforge.local/schemas/contracts/pitchapi-v5-evaluation-evidence-v1.schema.json",
  "title": "PitchApiDomainStratifiedEvaluationV5EvidenceV1",
  "type": "object",
  "required": [
    "contract",
    "protocol_id",
    "target_count",
    "simulation_parity",
    "heterogeneity",
    "domain_metrics",
    "aggregate_metrics",
    "result_classification"
  ],
  "properties": {
    "contract": {"const": "PitchApiDomainStratifiedEvaluationV5EvidenceV1"},
    "protocol_id": {"const": "PITCHAPI_DOMAIN_STRATIFIED_EVALUATION_V5"},
    "target_count": {"const": 712},
    "simulation_parity": {
      "type": "object",
      "required": ["forecast_validation_count", "status", "warning_count"],
      "properties": {
        "forecast_validation_count": {"const": 1424},
        "status": {"enum": ["PASS", "PASS_WITH_WARNINGS"]},
        "warning_count": {"type": "integer", "minimum": 0}
      }
    },
    "heterogeneity": {"type": "object"},
    "domain_metrics": {"type": "object"},
    "aggregate_metrics": {"type": "object"},
    "result_classification": {
      "enum": ["CHALLENGER_SUPPORTED", "REFERENCE_RETAINED"]
    }
  },
  "additionalProperties": true
}
