{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DatasetManifestV1",
  "type": "object",
  "required": ["contract", "dataset_version_id", "dataset_name", "schema_version", "schema_sha256", "source_git_sha", "normalizer_version", "files"],
  "properties": {
    "contract": {"const": "DatasetManifestV1"},
    "dataset_version_id": {"type": "string"},
    "dataset_name": {"type": "string"},
    "schema_version": {"type": "string"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "normalizer_version": {"type": "string"},
    "build_spec": {"type": "object"},
    "build_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "row_count", "size_bytes", "physical_sha256", "logical_sha256"],
        "properties": {
          "relative_path": {"type": "string"},
          "row_count": {"type": "integer", "minimum": 0},
          "size_bytes": {"type": "integer", "minimum": 0},
          "physical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "logical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
