{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchforge.local/schemas/transferable-rolling-npxg-dixon-coles-v2-development-evidence-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "admission_checks": {"additionalProperties": {"type": "boolean"}, "type": "object"},
    "artifact_round_trip": {"const": "PASS_EXACT_PREDICTION_EQUALITY"},
    "calibration": {"type": "object"},
    "comparison_artifacts": {"type": "object"},
    "contract": {"const": "TransferableRollingNpxgForAgainstDixonColesV2DevelopmentEvidenceV1"},
    "development_only": {"const": true},
    "development_target_count": {"const": 1270},
    "firewall_reverification": {"type": "object"},
    "leave_domain_out_prediction_count": {"minimum": 1, "type": "integer"},
    "leave_team_out": {"type": "object"},
    "metrics": {"type": "object"},
    "preregistration_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "research_id": {"const": "TRANSFERABLE_ROLLING_NPXG_FOR_AGAINST_DIXON_COLES_V2_RESEARCH_V1"},
    "result_classification": {"enum": ["DEVELOPMENT_ADMITTED_FOR_CONFIRMATION", "DEVELOPMENT_REJECTED", "INCONCLUSIVE"]},
    "scientific_limitations": {"items": {"type": "string"}, "type": "array"},
    "selected_regularization": {"items": {"type": "number"}, "maxItems": 3, "minItems": 3, "type": "array"},
    "selection": {"type": "object"}
  },
  "required": [
    "admission_checks",
    "artifact_round_trip",
    "calibration",
    "comparison_artifacts",
    "contract",
    "development_only",
    "development_target_count",
    "firewall_reverification",
    "leave_domain_out_prediction_count",
    "leave_team_out",
    "metrics",
    "preregistration_sha256",
    "research_id",
    "result_classification",
    "scientific_limitations",
    "selected_regularization",
    "selection"
  ],
  "title": "Transferable rolling npxG Dixon-Coles V2 development evidence",
  "type": "object"
}
