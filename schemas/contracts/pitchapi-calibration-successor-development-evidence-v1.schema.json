      "type": "object",
      "required": ["status", "v5_target_rows_loaded", "evaluation_outcome_rows_loaded", "fitting_or_model_selection_use"],
      "properties": {
        "status": {"const": "PASS"},
        "v5_target_rows_loaded": {"const": 0},
        "evaluation_outcome_rows_loaded": {"const": 0},
        "fitting_or_model_selection_use": {"const": false}
      }
    },
    "metrics": {"type": "object"},
    "calibration": {"type": "object"},
