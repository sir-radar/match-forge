    "research_id": {"const": "PITCHAPI_V5_CALIBRATION_SUCCESSOR_RESEARCH_V1"},
    "development_manifest_sha256": {"const": "be4251a4f53307bae0895c856b5a9ffdf21cdd64da9f0610c8273924d4bef62e"},
    "development_target_count": {"const": 216},
    "oos_prediction_count": {"const": 144},
    "validation_target_count": {"const": 108},
