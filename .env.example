# Local development only. Copy to .env and provide every required value.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=

# MVP product services.
DATABASE_URL=
POSTGRES_ADDR=
REDIS_ADDR=
API_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
NEXT_PUBLIC_TIME_ZONE=Africa/Lagos
FOOTBALL_DATA_ROOT=.local/football-data
MVP_HISTORY_SYNC_CONCURRENCY=3
API_FOOTBALL_MAX_HISTORY_SEASON=2024
MATCHFORGE_CONTEXT_SYNC_ENABLED=false
MATCHFORGE_INJURY_SYNC_ENABLED=false
MATCHFORGE_LINEUP_SYNC_ENABLED=false
MATCHFORGE_CONTEXT_REQUEST_CAP=100
MATCHFORGE_API_FOOTBALL_DAILY_RESERVE=20
MATCHFORGE_MODEL_CONTROL_ENABLED=true
MATCHFORGE_MODEL_DIXON_COLES_ENABLED=false
MATCHFORGE_MODEL_HIERARCHICAL_BAYES_ENABLED=false
MATCHFORGE_MODEL_NEGATIVE_BINOMIAL_ENABLED=false
MATCHFORGE_MODEL_WEIBULL_ENABLED=false
MATCHFORGE_ENSEMBLE_ENABLED=false
MATCHFORGE_MODEL_ARTIFACT_ROOT=.local/model-artifacts
API_FOOTBALL_PREDICTIONS_ENABLED=false
SPORTMONKS_PREDICTIONS_ENABLED=false
MATCHFORGE_FOTMOB_ENABLED=false
MATCHFORGE_PITCHAPI_ENABLED=false
MATCHFORGE_OPERATIONAL_SYNC_INTERVAL=0
MATCHFORGE_HISTORY_SYNC_ENABLED=false
MATCHFORGE_HISTORY_SYNC_INTERVAL=1h
MATCHFORGE_FOTMOB_HISTORY_SCOPE_LIMIT=2
MATCHFORGE_PITCHAPI_HISTORY_SCOPE_LIMIT=2
MATCHFORGE_HISTORY_DISCOVERY_LIMIT=1
MATCHFORGE_HISTORY_FRESHNESS_SECONDS=86400
MATCHFORGE_PROVIDER_CONNECTION_TIMEOUT_SECONDS=5
MATCHFORGE_PROVIDER_REQUEST_TIMEOUT_SECONDS=20
MATCHFORGE_PROVIDER_MIN_INTERVAL_SECONDS=1
MATCHFORGE_PROVIDER_DETAILS_LIMIT=10
MATCHFORGE_LIVE_STALE_AFTER_SECONDS=180

# Disposable Sprint 1 prototype database.
PROTOTYPE_POSTGRES_DB=
PROTOTYPE_POSTGRES_USER=
PROTOTYPE_POSTGRES_PASSWORD=
PROTOTYPE_POSTGRES_PORT=
FOOTBALL_PROTOTYPE_DATABASE_URL=
# Automated public prediction collection is authorized only for private local analysis.
EXTERNAL_PREDICTION_USAGE_MODE=PRIVATE_LOCAL
# Optional owner-approved JSON import consumed by the scheduled external-prediction job.
MVP_EXTERNAL_PREDICTIONS_IMPORT_FILE=

# Provider credentials. Copy this file to .env; never commit real values.
API_FOOTBALL_API_KEY=
SPORTMONKS_API_TOKEN=
FOOTBALL_DATA_DOT_ORG_API_TOKEN=
PITCH_API_TOKEN=
# Origin-less loopback admin automation only; never expose in NEXT_PUBLIC_*.
MATCHFORGE_ADMIN_CLI_TOKEN=

# HTTP serving limits; durable jobs retain their own execution limits.
READ_TIMEOUT=15s
HANDLER_TIMEOUT=30s
WRITE_TIMEOUT=35s
IDLE_TIMEOUT=60s

# Measured supported historical ZIP safety ceilings.
MATCHFORGE_ARCHIVE_COMPRESSED_BYTES=2097152
MATCHFORGE_ARCHIVE_EXTRACTED_BYTES=16777216
MATCHFORGE_ARCHIVE_ENTRIES=128
MATCHFORGE_ARCHIVE_FILE_BYTES=1048576
MATCHFORGE_ARCHIVE_RATIO=32
MATCHFORGE_ARCHIVE_EXTRACTION_SECONDS=5
