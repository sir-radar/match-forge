# Local development only. Copy to .env and provide every required value.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
REDIS_PORT=

# MVP product services.
DATABASE_URL=
POSTGRES_ADDR=
REDIS_ADDR=
API_ADDR=127.0.0.1:8080
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
FOOTBALL_DATA_ROOT=.local/football-data
MVP_HISTORY_SYNC_CONCURRENCY=3
API_FOOTBALL_MAX_HISTORY_SEASON=2024
MATCHFORGE_MODEL_CONTROL_ENABLED=true
MATCHFORGE_MODEL_DIXON_COLES_ENABLED=false
MATCHFORGE_MODEL_HIERARCHICAL_BAYES_ENABLED=false
MATCHFORGE_MODEL_NEGATIVE_BINOMIAL_ENABLED=false
MATCHFORGE_MODEL_WEIBULL_ENABLED=false
MATCHFORGE_ENSEMBLE_ENABLED=false
MATCHFORGE_MODEL_ARTIFACT_ROOT=.local/model-artifacts
API_FOOTBALL_PREDICTIONS_ENABLED=false
SPORTMONKS_PREDICTIONS_ENABLED=false

# Disposable Sprint 1 prototype database.
PROTOTYPE_POSTGRES_DB=
PROTOTYPE_POSTGRES_USER=
PROTOTYPE_POSTGRES_PASSWORD=
PROTOTYPE_POSTGRES_PORT=
FOOTBALL_PROTOTYPE_DATABASE_URL=
# Automated public prediction collection is authorized only for private local analysis.
EXTERNAL_PREDICTION_USAGE_MODE=PRIVATE_LOCAL
# Optional owner-approved JSON import consumed by the scheduled external-prediction job.
MVP_EXTERNAL_PREDICTIONS_IMPORT_FILE=

# Provider credentials. Copy this file to .env; never commit real values.
API_FOOTBALL_API_KEY=
SPORTMONKS_API_TOKEN=
FOOTBALL_DATA_DOT_ORG_API_TOKEN=
PITCH_API_TOKEN=
